#!/bin/sh
set -eu
case "${1:-}" in
 up|down)
   current=$(pactl get-sink-volume @DEFAULT_SINK@ | sed -n 's/.* \([0-9][0-9]*\)%.*/\1/p' | head -n 1)
   [ -n "$current" ] || exit 1
   if [ "$1" = up ]; then target=$((current + 5)); else target=$((current - 5)); fi
   [ "$target" -le 100 ] || target=100
   [ "$target" -ge 0 ] || target=0
   pactl set-sink-volume @DEFAULT_SINK@ "$target%" ;;
 mute) pactl set-sink-mute @DEFAULT_SINK@ toggle ;;
 *) exit 2 ;;
esac
