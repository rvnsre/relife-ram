#!/bin/sh
if command -v xsetroot >/dev/null; then
  xsetroot -solid '#111c3c'
fi
pcmanfm --desktop --profile ReLife >/tmp/relife-desktop.log 2>&1 &
if command -v pulseaudio >/dev/null; then
  pulseaudio --start --exit-idle-time=12 >/tmp/relife-audio.log 2>&1
fi
if command -v nm-applet >/dev/null; then
  nm-applet >/tmp/relife-network.log 2>&1 &
fi
touchegg >"$HOME/.relife-gestures.log" 2>&1 &
command -v firefox-esr >/dev/null && xdg-settings set default-web-browser relife-firefox.desktop >/dev/null 2>&1 || true
